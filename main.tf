########################################################################
# DigiCert Trust Lifecycle Manager - TLS certificates via Terraform
#
# Configuration lives in terraform.tfvars (generated by ./configure.sh);
# the variables are documented in variables.tf:
#   - domain           -> certificate common name + nginx server_name
#   - cert_dir         -> where key and certificate are stored
#   - digicert_url     -> DigiCert ONE instance
#   - digicert_api_key -> DigiCert ONE / TLM API key
#   - profile_id       -> TLM certificate profile
#   - renew_after_days -> how often key and certificate are re-issued
#
# Flow:
#   1. time_rotating          -> renewal clock, "expires" every renew_after_days
#   2. tls_private_key        -> private key (never leaves the machine)
#   3. tls_cert_request       -> CSR built from the local key
#   4. digicert_certificate   -> certificate enrolled from the TLM profile
#   5. local_(sensitive_)file -> key + certificate written to cert_dir
#   6. local_file             -> nginx site with server_name = domain
#   7. terraform_data         -> reload nginx whenever cert or site change
#
# Renewal: when the renewal clock expires, key, CSR and certificate are
# replaced (the provider would otherwise only "update" the certificate
# in place without re-enrolling it). create_before_destroy makes sure the
# new certificate is issued and written to disk before the old one is
# revoked in TLM.
# Something has to run `terraform apply` regularly for this to happen;
# install.sh sets up a systemd timer that calls renew.sh.
########################################################################

terraform {
  required_providers {
    digicert = { source = "digicert/digicert", version = "~> 0.1" }
    tls      = { source = "hashicorp/tls", version = "~> 4.0" }
    local    = { source = "hashicorp/local", version = "~> 2.5" }
    time     = { source = "hashicorp/time", version = "~> 0.12" }
  }
}

# ── DigiCert ONE / TLM access ───────────────────────────────────────────
provider "digicert" {
  url     = var.digicert_url
  api_key = var.digicert_api_key
}

# ── Renewal clock ───────────────────────────────────────────────────────
# Gets replaced once rotation_days have passed, which in turn forces the
# key and the certificate below to be re-created.
resource "time_rotating" "renew" {
  rotation_days = var.renew_after_days
}

# ── Locally generated key + CSR ─────────────────────────────────────────
resource "tls_private_key" "srv" {
  algorithm = "RSA"
  rsa_bits  = 2048

  lifecycle {
    replace_triggered_by  = [time_rotating.renew]
    create_before_destroy = true
  }
}

resource "tls_cert_request" "srv" {
  private_key_pem = tls_private_key.srv.private_key_pem
  subject {
    common_name  = var.domain
    organization = var.organization
  }
}

# ── Enroll the certificate from the TLM profile ─────────────────────────
# The digicert provider treats changes to profile_id, common_name and csr
# as in-place updates and does NOT enroll a new certificate for them.
# replace_triggered_by below forces a fresh enrollment whenever the
# renewal clock expires, the CSR changes (new key, domain or organization)
# or the profile changes.
resource "terraform_data" "cert_params" {
  triggers_replace = [var.profile_id]
}

resource "digicert_certificate" "srv" {
  profile_id  = var.profile_id
  common_name = var.domain
  csr         = tls_cert_request.srv.cert_request_pem
  tags        = var.tags

  lifecycle {
    replace_triggered_by = [
      time_rotating.renew,
      tls_cert_request.srv.cert_request_pem,
      terraform_data.cert_params,
    ]
    create_before_destroy = true
  }
}

# ── Write key and certificate to disk ───────────────────────────────────
resource "local_sensitive_file" "key" {
  filename        = "${var.cert_dir}/tls.key"
  content         = tls_private_key.srv.private_key_pem
  file_permission = "0600"
}

resource "local_file" "crt" {
  filename        = "${var.cert_dir}/tls.crt"
  content         = digicert_certificate.srv.certificate
  file_permission = "0644"
}

# ── Generate the nginx site for the domain ──────────────────────────────
resource "local_file" "nginx_site" {
  filename        = "/etc/nginx/sites-available/default"
  file_permission = "0644"
  content         = <<-EOT
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name ${var.domain} _;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2 default_server;
        listen [::]:443 ssl http2 default_server;

        server_name ${var.domain};

        ssl_certificate     ${var.cert_dir}/tls.crt;
        ssl_certificate_key ${var.cert_dir}/tls.key;

        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        root  /var/www/html;
        index index.html;

        location / {
            try_files $uri $uri/ =404;
        }
    }
  EOT
}

# ── Reload nginx whenever certificate or site change ────────────────────
resource "terraform_data" "nginx_reload" {
  triggers_replace = [
    digicert_certificate.srv.certificate,
    local_file.nginx_site.content,
  ]
  provisioner "local-exec" {
    command = "nginx -t && systemctl reload nginx"
  }
  depends_on = [local_file.crt, local_sensitive_file.key, local_file.nginx_site]
}

# ── Useful outputs ──────────────────────────────────────────────────────
# Parse the issued certificate: apart from the PEM and the serial number
# the provider returns nothing (request_id stays empty on enrollment).
data "tls_certificate" "srv" {
  content = digicert_certificate.srv.certificate
}

locals {
  leaf_cert = [for c in data.tls_certificate.srv.certificates : c if !c.is_ca][0]
}

output "certificate_serial" { value = digicert_certificate.srv.serial_number }
output "certificate_domain" { value = var.domain }
output "certificate_not_before" { value = local.leaf_cert.not_before }
output "certificate_not_after" { value = local.leaf_cert.not_after }
output "next_renewal_after" { value = time_rotating.renew.rotation_rfc3339 }
