# Template for terraform.tfvars. The easiest way to create it is ./configure.sh.
# terraform.tfvars is excluded via .gitignore because it contains the API key.

digicert_url     = "https://one.digicert.com"
digicert_api_key = "<DigiCert ONE API key>"
profile_id       = "00000000-0000-0000-0000-000000000000"

domain       = "www.example.com"
organization = "Example Inc."
tags         = "terraform"

# Re-issue key and certificate once this percentage of the current
# certificate's validity has elapsed (validity is read from the certificate
# on disk, so it follows whatever the profile issues).
renew_at_percent = 70

cert_dir = "/etc/certs"
